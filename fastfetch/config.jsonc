        { "type": "disk", "folders": "/home/sterandr", "key": "\u001b[38;2;214;214;212m\u2514 \uf0a0  Disk\u001b[0m" },
        "break",

        { "type": "custom", "format": "\u001b[38;2;179;156;137m\u2500\u2500\u2500\u2500\u2500 Software \u2500\u2500\u2500\u2500\u2500\u001b[0m" },
        { "type": "os",       "key": "\u001b[38;2;199;190;177m\u251c \uf17c  OS\u001b[0m" },
        { "type": "kernel",   "key": "\u001b[38;2;199;190;177m\u251c \uf013  Kernel\u001b[0m" },
        { "type": "packages", "key": "\u001b[38;2;199;190;177m\u251c \uf187  Pkgs\u001b[0m" },
